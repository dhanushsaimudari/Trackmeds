rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for hierarchical RBAC enforcement
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNationalAdmin() {
      return isAuthenticated() && request.auth.token.role == 'NATIONAL_ADMIN';
    }

    function isStateOfficer(state) {
      return isAuthenticated() && 
             request.auth.token.role == 'STATE_OFFICER' && 
             request.auth.token.state == state;
    }

    function isDistrictOfficer(state, district) {
      return isAuthenticated() && 
             request.auth.token.role == 'DISTRICT_OFFICER' && 
             request.auth.token.state == state &&
             request.auth.token.district == district;
    }

    function isPHCStaff(facilityId) {
      return isAuthenticated() && 
             request.auth.token.role == 'PHC_STAFF' && 
             request.auth.token.facility_id == facilityId;
    }

    // User profile documents
    match /users/{userId} {
      // Users can view their own profile; National Admin can view all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isNationalAdmin());
      // Users can create/update only their basic contact info (cannot elevate role or self-approve)
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.approval_status == 'pending';
      allow update: if isNationalAdmin() ||
                       (isAuthenticated() && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approval_status', 'is_active']));
      allow delete: if isNationalAdmin();
    }

    // Facilities collection
    match /facilities/{facilityId} {
      allow read: if isNationalAdmin() ||
                     isStateOfficer(resource.data.state) ||
                     isDistrictOfficer(resource.data.state, resource.data.district) ||
                     isPHCStaff(facilityId);

      allow write: if isNationalAdmin() ||
                      isStateOfficer(resource.data.state) ||
                      isDistrictOfficer(resource.data.state, resource.data.district) ||
                      (isPHCStaff(facilityId) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occupied_beds', 'doctors_available', 'nurses_available', 'support_available', 'last_beds_updated', 'last_staff_updated']));
    }

    // Inventory collection (supports both singular and plural)
    match /inventory/{inventoryId} {
      allow read: if isNationalAdmin() ||
                     isStateOfficer(resource.data.state) ||
                     isDistrictOfficer(resource.data.state, resource.data.district) ||
                     isPHCStaff(resource.data.facility_id);

      allow write: if isNationalAdmin() ||
                      isStateOfficer(resource.data.state) ||
                      isDistrictOfficer(resource.data.state, resource.data.district) ||
                      isPHCStaff(resource.data.facility_id);
    }

    match /inventories/{inventoryId} {
      allow read: if isNationalAdmin() ||
                     isStateOfficer(resource.data.state) ||
                     isDistrictOfficer(resource.data.state, resource.data.district) ||
                     isPHCStaff(resource.data.facility_id);

      allow write: if isNationalAdmin() ||
                      isStateOfficer(resource.data.state) ||
                      isDistrictOfficer(resource.data.state, resource.data.district) ||
                      isPHCStaff(resource.data.facility_id);
    }

    // Forecasts collection
    match /forecasts/{forecastId} {
      allow read: if isNationalAdmin() ||
                     isStateOfficer(resource.data.state) ||
                     isDistrictOfficer(resource.data.state, resource.data.district) ||
                     isPHCStaff(resource.data.facility_id);

      allow write: if isNationalAdmin();
    }

    // Redistributions collection
    match /redistributions/{redistributionId} {
      allow read: if isNationalAdmin() ||
                     isStateOfficer(resource.data.source_state) ||
                     isStateOfficer(resource.data.destination_state) ||
                     isDistrictOfficer(resource.data.source_state, resource.data.source_district) ||
                     isDistrictOfficer(resource.data.destination_state, resource.data.destination_district) ||
                     isPHCStaff(resource.data.source_facility_id) ||
                     isPHCStaff(resource.data.destination_facility_id);

      allow write: if isNationalAdmin() ||
                      isStateOfficer(resource.data.destination_state) ||
                      isDistrictOfficer(resource.data.destination_state, resource.data.destination_district) ||
                      isPHCStaff(resource.data.destination_facility_id);
    }

    // Replenishments collection
    match /replenishments/{replenishmentId} {
      allow read: if isNationalAdmin() ||
                     isStateOfficer(resource.data.state) ||
                     isDistrictOfficer(resource.data.state, resource.data.district) ||
                     isPHCStaff(resource.data.facility_id);

      allow write: if isNationalAdmin() ||
                      isStateOfficer(resource.data.state) ||
                      isDistrictOfficer(resource.data.state, resource.data.district);
    }

    // Emergency SOS Requests
    match /emergency_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isNationalAdmin() || isStateOfficer(resource.data.state);
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
