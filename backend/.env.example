# =============================================================================
# TRACKMEDS Backend Environment Configuration Example
# =============================================================================

# Server Environment & Port
ENVIRONMENT=development
PORT=8000

# Authentication & JWT Security (Set a strong 32+ character random secret in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# SQLite / PostgreSQL Database Connection URL
DATABASE_URL=sqlite:///./trackmeds.db

# Google Gemini API Key (Optional: system provides deterministic clinical fallbacks if empty)
GEMINI_API_KEY=

# OpenWeather API Key (Optional: synthetic regional climate anomalies simulated if empty)
WEATHER_API_KEY=

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=trackmeds-health
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Allowed CORS Origins (comma-separated URLs, e.g. https://your-cloud-run-url.run.app)
ALLOWED_ORIGINS=
