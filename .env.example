# =============================================================================
# TRACKMEDS Configuration Environment Variables
# =============================================================================

# --- Backend Settings ---
# Google Gemini API Key (Optional: system operates with intelligent rule-based fallbacks if empty)
GEMINI_API_KEY=

# OpenWeather API Key (Optional: system uses synthetic climate signals if empty)
WEATHER_API_KEY=

# Database Connection (Defaults to local SQLite database in backend directory)
DATABASE_URL=sqlite:///./trackmeds.db

# Environment & Server Port
ENVIRONMENT=development
PORT=8000

# --- Frontend Settings (Vite prefix VITE_) ---
# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Google Maps Platform API Key (Optional: Map automatically falls back to Leaflet OpenStreetMap if empty)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Configuration (Optional: for cloud persistence/auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=trackmeds-health.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trackmeds-health
VITE_FIREBASE_STORAGE_BUCKET=trackmeds-health.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1029384756
VITE_FIREBASE_APP_ID=1:1029384756:web:trackmeds2026
