# TRACKMEDS Configuration Environment Variables

# Google Gemini API Key (Optional: system runs with intelligent fallbacks if empty)
GEMINI_API_KEY=

# OpenWeather API Key (Optional: system uses synthetic climate signals if empty)
WEATHER_API_KEY=

# Database Connection (Defaults to local SQLite database)
DATABASE_URL=sqlite:///./trackmeds.db

# Environment
ENVIRONMENT=development
PORT=8000
